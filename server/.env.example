# Copia este archivo como server/.env y llena los valores.
# server/.env NUNCA se sube al repositorio.

NODE_ENV=development
PORT=4000

# Zona horaria del consultorio (agenda, "hoy", vencimientos)
TZ=America/Mexico_City

# MongoDB Atlas → Database → Connect → Drivers. Usa un usuario de BD con permisos
# sólo sobre esta base y agrega tu IP en Network Access.
MONGODB_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/la_nutria?retryWrites=true&w=majority

# Genera cada secreto con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_TTL_DAYS=7

# Orígenes del frontend permitidos (separados por coma)
CORS_ORIGINS=http://localhost:5173

LOG_LEVEL=info

# Cada cuántos minutos se evalúan las reglas de alerta (0 = desactivado)
ALERTS_JOB_MINUTES=15

# Fotos y documentos (módulo opcional)
FEATURE_ATTACHMENTS=true
UPLOAD_DIR=uploads
UPLOAD_MAX_MB=10

# Superusuario inicial (sólo lo usa `npm run seed`; puedes borrarlo después)
SEED_SUPERUSER_NAME=Administrador General
SEED_SUPERUSER_EMAIL=
SEED_SUPERUSER_PASSWORD=

# Sólo para `npm run seed:demo` (datos ficticios en una BD real)
SEED_DEMO_PASSWORD=
